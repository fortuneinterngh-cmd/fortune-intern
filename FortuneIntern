  /* APPLY + PAYSTACK */
  function resetPayBtn() { var b = $('paySubmitBtn'); b.disabled = false; b.innerHTML = PAY_BTN_HTML; }
  function handleApplySubmit(e) {
    e.preventDefault();
    if (!isAuthenticated()) { showToast('Please sign in first', 'error'); showPage('auth'); return; }
    var req = ['appFirstName','appLastName','appPhone','appEmail','appCourse','appYear','appIndex','appCompany','appAddress'];
    for (var i = 0; i < req.length; i++) { if (!$(req[i]).value.trim()) { showToast('Please fill all required fields', 'error'); $(req[i]).focus(); return; } }
    var inst = $('appInstitution').value;
    if (!inst) { showToast('Please select your institution', 'error'); $('appInstitution').focus(); return; }
    if (inst === 'Other' && !$('appInstitutionOther').value.trim()) { showToast('Please specify your institution', 'error'); $('appInstitutionOther').focus(); return; }
    var genderEl = document.querySelector('input[name="gender"]:checked');
    if (!genderEl) { showToast('Please select your gender', 'error'); return; }
    var phone = $('appPhone').value.replace(/\D/g, '');
    if (phone.length < 10) { showToast('Enter a valid 10-digit phone number', 'error'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test($('appEmail').value.trim())) { showToast('Enter a valid email address', 'error'); return; }

    var payload = {
      firstName: $('appFirstName').value.trim(), lastName: $('appLastName').value.trim(), gender: genderEl.value,
      phone: phone, email: $('appEmail').value.trim(),
      institution: (inst === 'Other') ? $('appInstitutionOther').value.trim() : inst,
      course: $('appCourse').value.trim(), year: $('appYear').value, index: $('appIndex').value.trim(),
      company: $('appCompany').value.trim(), address: $('appAddress').value.trim(), suggested: $('appSuggested').value,
      resume: $('uploadText').textContent, ref: 'FIN_' + Date.now(), submittedAt: new Date().toISOString()
    };

    var btn = $('paySubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<div class="spinner" style="display:block;border-color:rgba(255,255,255,0.3);border-top-color:#fff;"></div><span>Processing…</span>';

    if (typeof window.PaystackPop === 'undefined' || PAYSTACK_PUBLIC_KEY.indexOf('xxxx') !== -1) {
      setTimeout(function () { finalizeApplication(payload, true); resetPayBtn(); }, 1400);
      return;
    }
    try {
      var handler = window.PaystackPop.setup({
        key: PAYSTACK_PUBLIC_KEY, email: payload.email, amount: APPLICATION_FEE_GHS * 100, currency: 'GHS', ref: payload.ref,
        metadata: { custom_fields: [
          { display_name: 'Applicant', variable_name: 'applicant', value: payload.firstName + ' ' + payload.lastName },
          { display_name: 'Institution', variable_name: 'institution', value: payload.institution },
          { display_name: 'Company', variable_name: 'company', value: payload.company } ] },
        callback: function (resp) { payload.paymentRef = resp.reference; payload.paymentStatus = 'paid'; finalizeApplication(payload, true); resetPayBtn(); },
        onClose: function () { showToast('Payment cancelled — application not submitted.', 'error'); resetPayBtn(); }
      });
      handler.openIframe();
    } catch (err) { showToast('Payment service unavailable', 'error'); resetPayBtn(); }
  }
  function finalizeApplication(p, ok) {
    if (!ok) return;
    var apps = sGet(localStorage, APPS_KEY, []); if (!Array.isArray(apps)) apps = [];
    apps.push(p); sSet(localStorage, APPS_KEY, apps);
    showToast('Payment received — application submitted! 🎉');
    $('applyForm').reset();
    $('appInstitutionOtherWrap').classList.add('hidden');
    $('uploadText').textContent = 'Upload Resume (PDF) — optional';
    $('uploadBtn').classList.remove('has-file');
    setTimeout(function () { showPage('programs'); }, 1100);
  }

