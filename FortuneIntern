    state.aiOpen = !state.aiOpen;
    $('aiWindow').classList.toggle('open', state.aiOpen);
    if (state.aiOpen && $('aiMsgs').children.length === 0) setTimeout(function () { addBotMsg("Hi, I'm super, your ai assistant on the fortune intern network platform. Please feel free to ask me anything"); }, 320);
    if (state.aiOpen) setTimeout(function () { $('aiInput').focus(); }, 380);
  }
  function addUserMsg(t) { var d = document.createElement('div'); d.className = 'ai-msg user'; d.innerHTML = escapeHtml(t) + '<span class="ts">' + nowTs() + '</span>'; var m = $('aiMsgs'); m.appendChild(d); m.scrollTop = m.scrollHeight; }
  function addBotMsg(t) { var d = document.createElement('div'); d.className = 'ai-msg bot'; d.innerHTML = escapeHtml(t).replace(/\n/g, '<br>') + '<span class="ts">' + nowTs() + ' · Super</span>'; var m = $('aiMsgs'); m.appendChild(d); m.scrollTop = m.scrollHeight; }
  function showTyping() { var d = document.createElement('div'); d.className = 'ai-typing'; d.id = 'aiTyping'; d.innerHTML = '<span></span><span></span><span></span>'; var m = $('aiMsgs'); m.appendChild(d); m.scrollTop = m.scrollHeight; }
  function removeTyping() { var t = $('aiTyping'); if (t && t.parentNode) t.parentNode.removeChild(t); }

  function offlineAnswer(input) {
    var lower = String(input).toLowerCase();
    var best = null, bestScore = 0;
    for (var i = 0; i < state.kb.length; i++) {
      var entry = state.kb[i]; var q = String(entry.q).toLowerCase(); var score = 0;
      if (lower.indexOf(q) !== -1) score += 3;
      var kws = q.split(/[,\/\s]+/);
      for (var k = 0; k < kws.length; k++) if (kws[k].length > 2 && lower.indexOf(kws[k]) !== -1) score += 1;
      if (score > bestScore) { bestScore = score; best = entry; }
    }
    return best ? best.a : null;
  }
  function systemPrompt() {
    var core = [];
    for (var i = 0; i < state.kb.length; i++) if (state.kb[i].core) core.push(state.kb[i].q + ': ' + state.kb[i].a);
    return 'You are Super, the friendly AI assistant of Fortune Intern Network (FIN), Ghana. Facts: email fortuneintern.gh@gmail.com; WhatsApp +233 25 703 8948; WhatsApp Channel https://whatsapp.com/channel/0029Val97zy1yT2BGkOZi511; LinkedIn https://www.linkedin.com/company/fortune-intern-network/; office Accra, Ghana. Application fee GHS 3 via Paystack. Knowledge base:\n' + core.join('\n') + '\nAnswer concisely and warmly; help with CVs and cover letters on request.';
  }
  function callGPT(text, onDone) {
    var model = $('aiModel').value.trim() || state.aiModel || 'gpt-4o-mini';
    fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + state.aiKey },
      body: JSON.stringify({ model: model, temperature: 0.7, messages: [ { role: 'system', content: systemPrompt() }, { role: 'user', content: text } ] })
    }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (j) { onDone(j && j.choices && j.choices[0] && j.choices[0].message ? j.choices[0].message.content : null); })
      .catch(function () { onDone(null); });
  }
  function processUserMessage(text) {
    addUserMsg(text); $('aiInput').value = ''; showTyping(); $('aiSendBtn').disabled = true;
    function finish(reply) { removeTyping(); addBotMsg(reply); $('aiSendBtn').disabled = false; $('aiInput').focus(); }
    var off = offlineAnswer(text);
    if (state.aiKey) {
      callGPT(text, function (gptReply) {
        setTimeout(function () {
          if (gptReply) finish(gptReply);
          else if (off) finish(off + '\n\n(GPT unreachable — answered from my offline brain.)');
          else finish("I couldn't reach GPT and my offline brain has no entry for that yet. Train me via the  settings panel, or ask about FIN programs, applications, CVs or contact details.");
        }, 500);
      });
      return;
    }
    setTimeout(function () {
      if (off) finish(off);
      else finish("My offline brain doesn't cover that yet. Ask me about FIN programs, how to apply, CVs, cover letters, fees, companies or contacts — or train me via the ⚙ settings panel. Adding an OpenAI key upgrades me to full GPT for any topic.");
    }, 700 + Math.random() * 700);
  }
  function renderKBList() {
    var list = $('aiKbList'); if (!list) return;
    list.innerHTML = '';
    state.kb.forEach(function (item) {
      var row = document.createElement('div');
      row.className = 'ai-kb-item' + (item.core ? ' core' : '');
      var left = document.createElement('span');
      left.innerHTML = '<span class="ai-kb-q">' + escapeHtml(item.q) + '</span> — ' + escapeHtml(String(item.a).substring(0, 40)) + '…';
      row.appendChild(left);
      if (!item.core) {
        var del = document.createElement('span');
        del.className = 'ai-kb-del'; del.textContent = '✕'; del.setAttribute('role', 'button'); del.setAttribute('aria-label', 'Delete entry');
        del.addEventListener('click', function () { state.kb = state.kb.filter(function (x) { return x.id !== item.id; }); sSet(localStorage, AI_KB_KEY, state.kb); renderKBList(); showToast('Knowledge entry deleted'); });
        row.appendChild(del);
      }
      list.appendChild(row);
    });
  }

  /* CHARTS */
  function initCharts() {
    if (typeof window.Chart === 'undefined') return;
    var font = { family: 'Inter', size: 11, weight: '600' };
    var grid = 'rgba(226,232,240,0.7)';
    var r = $('radarChart');
    if (r && !r.dataset.init) {
      new window.Chart(r, { type: 'radar', data: { labels: ['Research','Critical Thinking','Analysis','Writing','Practical','Theory'], datasets: [{ label: 'Current Level', data: [85,70,80,65,75,60], backgroundColor: 'rgba(37,99,235,0.22)', borderColor: '#2563EB', borderWidth: 2, pointBackgroundColor: '#2563EB', pointBorderColor: '#fff', pointBorderWidth: 2, pointRadius: 4 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { r: { beginAtZero: true, max: 100, ticks: { display: false, stepSize: 20 }, grid: { color: grid }, angleLines: { color: grid }, pointLabels: { font: font, color: '#64748B', padding: 8 } } } } });
      r.dataset.init = '1';
    }
    var l = $('lineChart');
    if (l && !l.dataset.init) {
      new window.Chart(l, { type: 'line', data: { labels: ['W1','W2','W3','W4','W5','W6'], datasets: [{ label: 'Learning Intensity', data: [30,45,65,55,80,95], borderColor: '#2563EB', backgroundColor: 'rgba(37,99,235,0.08)', borderWidth: 2.5, fill: true, tension: 0.4, pointBackgroundColor: '#2563EB', pointBorderColor: '#fff', pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { font: font, color: '#64748B' } }, y: { beginAtZero: true, max: 100, grid: { color: grid }, ticks: { display: false } } } } });
      l.dataset.init = '1';
    }
    var b = $('barChart');
    if (b && !b.dataset.init) {
      new window.Chart(b, { type: 'bar', data: { labels: ['Jan','Feb','Mar','Apr','May','Jun'], datasets: [ { label: 'Desktop', data: [65,78,90,85,95,110], backgroundColor: '#0A1F44', borderRadius: 6, borderSkipped: false }, { label: 'Mobile', data: [45,60,75,80,88,100], backgroundColor: '#2563EB', borderRadius: 6, borderSkipped: false } ] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top', align: 'end', labels: { font: font, color: '#64748B', boxWidth: 12, padding: 12, usePointStyle: true } } }, scales: { x: { grid: { display: false }, ticks: { font: font, color: '#64748B' } }, y: { beginAtZero: true, grid: { color: grid }, ticks: { font: font, color: '#94A3B8', stepSize: 30 } } } } });
      b.dataset.init = '1';
    }
  }

  function animateCounters() {
    var counters = document.querySelectorAll('.stat-num');
    for (var i = 0; i < counters.length; i++) {
      (function (c) {
        if (c.dataset.animated) return;
        var target = parseInt(c.getAttribute('data-target'), 10) || 0;
        var step = target / (1500 / 16); var cur = 0;
        var t = setInterval(function () {
          cur += step;
          if (cur >= target) { var lbl = c.parentElement.querySelector('.stat-lbl').textContent; c.textContent = target + (lbl.indexOf('%') !== -1 ? '%' : '+'); clearInterval(t); }
          else c.textContent = Math.floor(cur);
        }, 16);
        c.dataset.animated = '1';
      })(counters[i]);
    }
  }

  function bindAll() {
    var tabs = document.querySelectorAll('.auth-tab');
    for (var i = 0; i < tabs.length; i++) tabs[i].addEventListener('click', function () { switchAuthTab(this.getAttribute('data-tab')); });
    $('loginForm').addEventListener('submit', function (e) { e.preventDefault(); performLogin(); });
    $('signupForm').addEventListener('submit', function (e) { e.preventDefault(); performSignup(); });

    var eyeOpen = '<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
    var eyeOff = '<svg viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
    var pws = document.querySelectorAll('.pw-toggle');
    for (var p = 0; p < pws.length; p++) {
      pws[p].addEventListener('click', function () {
        var inp = $(this.getAttribute('data-target')); if (!inp) return;
        var toText = inp.type === 'password';
        inp.type = toText ? 'text' : 'password';
        this.innerHTML = toText ? eyeOff : eyeOpen;
      });
    }

    $('drawerClose').addEventListener('click', closeDrawer);
    $('drawerOverlay').addEventListener('click', closeDrawer);
    $('drawerLogoutBtn').addEventListener('click', function () { closeDrawer(); handleLogout(); });
    var dlinks = document.querySelectorAll('.drawer-link');
    for (var d = 0; d < dlinks.length; d++) {
      dlinks[d].addEventListener('click', function (e) {
        e.preventDefault();
        var page = this.getAttribute('data-page');
        if (page === 'about') { showPage('home'); setTimeout(function () { var el = $('aboutSection'); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 120); }
        else if (page === 'contact') { showPage('home'); setTimeout(function () { var el = $('contactSection'); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 120); }
        else showPage(page);
      });
    }

    var navs = document.querySelectorAll('.nav-item');
    for (var n = 0; n < navs.length; n++) navs[n].addEventListener('click', function () { showPage(this.getAttribute('data-page')); });
    var jnavs = document.querySelectorAll('.js-nav');
    for (var jn = 0; jn < jnavs.length; jn++) jnavs[jn].addEventListener('click', function () { showPage(this.getAttribute('data-page')); });
    var dets = document.querySelectorAll('.js-details');
    for (var dt = 0; dt < dets.length; dt++) dets[dt].addEventListener('click', function () { showToast('"' + this.getAttribute('data-title') + '" — full details coming soon.'); });
    var soons = document.querySelectorAll('.js-soon');
    for (var s = 0; s < soons.length; s++) soons[s].addEventListener('click', function (e) { e.preventDefault(); showToast('This page is coming soon.'); });

    function featuredGo() { if (isAuthenticated()) showPage('programs'); else { showToast('Sign in to explore FIN Academy', 'error'); showPage('auth'); } }
    var feats = document.querySelectorAll('.featured-card');
    for (var f = 0; f < feats.length; f++) {
      feats[f].addEventListener('click', featuredGo);
      feats[f].addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); featuredGo(); } });
    }
    $('heroExploreBtn').addEventListener('click', featuredGo);

    var chips = document.querySelectorAll('.filter-chip');
    for (var c = 0; c < chips.length; c++) {
      chips[c].addEventListener('click', function () {
        for (var x = 0; x < chips.length; x++) chips[x].classList.remove('active');
        this.classList.add('active');
        var fv = this.getAttribute('data-filter');
        var cards = document.querySelectorAll('.ann-card');
        for (var y = 0; y < cards.length; y++) cards[y].classList.toggle('hidden', fv !== 'all' && cards[y].getAttribute('data-cat') !== fv);
      });
    }
    $('annSearch').addEventListener('input', function () {
      var q = this.value.toLowerCase();
      var cards = document.querySelectorAll('.ann-card');
      for (var i2 = 0; i2 < cards.length; i2++) cards[i2].classList.toggle('hidden', cards[i2].textContent.toLowerCase().indexOf(q) === -1);
    });
    $('companySearch').addEventListener('input', function () { renderCompanies(this.value); });

    var ptabs = document.querySelectorAll('.prog-tab');
    for (var pt = 0; pt < ptabs.length; pt++) {
      ptabs[pt].addEventListener('click', function () {
        for (var z = 0; z < ptabs.length; z++) ptabs[z].classList.remove('active');
        this.classList.add('active');
        var t = this.getAttribute('data-tab');
        $('tabMy').classList.toggle('hidden', t !== 'my');
        $('tabExplore').classList.toggle('hidden', t !== 'explore');
      });
    }

    $('contactForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var nm = this.elements.cname.value.trim(), em = this.elements.cemail.value.trim(), ms = this.elements.cmessage.value.trim();
      if (!nm || !em || !ms) { showToast('Please fill name, email and message', 'error'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) { showToast('Please enter a valid email', 'error'); return; }
      showToast('Message sent! We will reply from fortuneintern.gh@gmail.com');
      this.reset();
    });

    $('applyForm').addEventListener('submit', handleApplySubmit);
    $('appInstitution').addEventListener('change', function () {
      var isOther = this.value === 'Other';
      $('appInstitutionOtherWrap').classList.toggle('hidden', !isOther);
      if (!isOther) $('appInstitutionOther').value = '';
    });
    $('resumeFile').addEventListener('change', function () {
      var file = this.files && this.files[0];
      if (file) { $('uploadText').textContent = file.name; $('uploadBtn').classList.add('has-file'); }
      else { $('uploadText').textContent = 'Upload Resume (PDF) — optional'; $('uploadBtn').classList.remove('has-file'); }
    });

    bindDocUpload('fileResume', 'upResumeBtn', 'upResumeText', 'Resume', 'Upload Resume (PDF/DOC)');
    bindDocUpload('fileLetter', 'upLetterBtn', 'upLetterText', 'Internship Letter', 'Upload Internship / Introduction Letter');
    bindDocUpload('fileCert', 'upCertBtn', 'upCertText', 'Certificate', 'Upload Certificates (PDF/Images)');

    $('avatarInput').addEventListener('change', function () {
      var file = this.files && this.files[0]; if (!file) return;
      var reader = new FileReader();
      reader.onload = function (ev) {
        var wrap = $('avatarWrap');
        var old = wrap.querySelector('img'); if (old) old.parentNode.removeChild(old);
        var img = document.createElement('img'); img.src = ev.target.result; img.alt = 'Profile';
        wrap.insertBefore(img, wrap.firstChild);
        var ini = $('profileAvatarInitials'); if (ini) ini.style.display = 'none';
      };
      reader.readAsDataURL(file);
      showToast('Profile photo updated!');
    });
    $('saveSettingsBtn').addEventListener('click', function () { updateProfileDisplay(); showToast('Profile saved successfully ✓'); });
    $('cancelSettingsBtn').addEventListener('click', function () { $('emailNotif').checked = true; $('smsNotif').checked = false; $('oppNotif').checked = true; showToast('Settings reset'); });
    $('logoutBtn').addEventListener('click', handleLogout);

    $('aiFab').addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); toggleAI(); });
    $('aiClose').addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); state.aiOpen = false; $('aiWindow').classList.remove('open'); });
    $('aiGear').addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); var s = $('aiSettings'); s.classList.toggle('open'); this.classList.toggle('on', s.classList.contains('open')); });
    $('aiForm').addEventListener('submit', function (e) { e.preventDefault(); e.stopPropagation(); var t = $('aiInput').value.trim(); if (t && !$('aiSendBtn').disabled) processUserMessage(t); });
    $('aiInput').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); var t = this.value.trim(); if (t && !$('aiSendBtn').disabled) processUserMessage(t); } });
    var quick = document.querySelectorAll('.ai-quick-btn');
    for (var q = 0; q < quick.length; q++) quick[q].addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); var t = this.getAttribute('data-q'); if (t) processUserMessage(t); });

    $('aiSaveKey').addEventListener('click', function () {
      var key = $('aiApiKey').value.trim();
      if (!key) { showToast('Paste an OpenAI API key first', 'error'); return; }
      state.aiKey = key; sSet(localStorage, AI_KEY_KEY, key);
      var model = $('aiModel').value.trim() || 'gpt-4o-mini'; state.aiModel = model; sSet(localStorage, AI_MODEL_KEY, model);
      aiSetModeText(); showToast('Super is now live on GPT!');
      $('aiSettings').classList.remove('open'); $('aiGear').classList.remove('on');
    });
    $('aiClearKey').addEventListener('click', function () { state.aiKey = null; sDel(localStorage, AI_KEY_KEY); $('aiApiKey').value = ''; aiSetModeText(); showToast('Back to offline brain'); });
    $('aiAddKb').addEventListener('click', function () {
      var q = $('aiKbQ').value.trim(), a = $('aiKbA').value.trim();
      if (!q || !a) { showToast('Add both a keyword and an answer', 'error'); return; }
      state.kb.push({ id: Date.now(), q: q, a: a, core: false });
      sSet(localStorage, AI_KB_KEY, state.kb);
      $('aiKbQ').value = ''; $('aiKbA').value = '';
      renderKBList(); showToast('Super learned something new!');
    });
    $('aiResetKb').addEventListener('click', function () {
      if (window.confirm('Reset knowledge base to FIN defaults?')) { state.kb = JSON.parse(JSON.stringify(DEFAULT_KB)); sSet(localStorage, AI_KB_KEY, state.kb); renderKBList(); showToast('Knowledge base reset to FIN defaults'); }
    });

    var sw = $('statsWrap');
    if (sw && 'IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        for (var i3 = 0; i3 < entries.length; i3++) if (entries[i3].isIntersecting) { animateCounters(); obs.unobserve(entries[i3].target); }
      }, { threshold: 0.3 });
      obs.observe(sw);
    } else if (sw) animateCounters();

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (state.aiOpen) { state.aiOpen = false; $('aiWindow').classList.remove('open'); }
        if ($('drawer').classList.contains('open')) closeDrawer();
      }
    });
  }

  function boot() {
    loadState();
    var users = getUsers(); var hasDemo = false;
    for (var i = 0; i < users.length; i++) if (users[i].username === 'SuperK5') hasDemo = true;
    if (!hasDemo) { users.push(DEMO_USER); saveUsers(users); }
    bindAll();
    renderKBList();
    aiSetModeText();
    $('paySubmitBtn').innerHTML = PAY_BTN_HTML;
    showPage(isAuthenticated() ? 'overview' : 'auth');
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
