<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0A1F44">
<title>Fortune Intern Network</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="https://js.paystack.co/v1/inline.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; width: 100%; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 1.5; color: #0F172A; background: #E2E8F0; -webkit-font-smoothing: antialiased; overflow: hidden; }
img, svg { display: block; max-width: 100%; }
button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }
input, textarea, select { font: inherit; color: inherit; }
a { color: inherit; text-decoration: none; cursor: pointer; }
ul, ol { list-style: none; }
h1, h2, h3, h4, h5, h6 { font-family: 'Poppins', 'Inter', sans-serif; }

:root {
  --primary: #0A1F44; --primary-light: #1E3A8A; --accent: #2563EB;
  --accent-soft: #DBEAFE; --yellow: #F5B927; --yellow-dark: #E6AE06;
  --white: #FFFFFF; --bg: #F1F5F9; --card: #FFFFFF; --text: #0F172A;
  --muted: #64748B; --muted-light: #94A3B8; --border: #E2E8F0;
  --success: #10B981; --success-soft: #D1FAE5; --warning: #F59E0B;
  --danger: #EF4444; --danger-soft: #FEE2E2;
  --shadow-sm: 0 2px 8px rgba(15,23,42,0.04);
  --shadow: 0 4px 20px rgba(15,23,42,0.06);
  --shadow-lg: 0 10px 40px rgba(15,23,42,0.12);
  --radius: 16px; --radius-sm: 10px;
  --header-h: 64px; --nav-h: 72px;
  --font-heading: 'Poppins', 'Inter', sans-serif;
}

.app-shell { position: relative; max-width: 480px; margin: 0 auto; height: 100vh; height: 100dvh; background: var(--bg); overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 0 60px rgba(15,23,42,0.15); }
@media (min-width: 481px) { body { display: flex; align-items: center; justify-content: center; padding: 20px 0; } .app-shell { height: calc(100vh - 40px); border-radius: 24px; } }

.app-header { position: fixed; top: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; height: var(--header-h); background: var(--white); display: flex; align-items: center; justify-content: space-between; padding: 0 16px; z-index: 100; border-bottom: 1px solid var(--border); }
@media (min-width: 481px) { .app-header { top: 20px; border-radius: 24px 24px 0 0; } }
.brand { display: flex; align-items: center; gap: 10px; }
.brand-logo-wrap { width: 40px; height: 40px; flex-shrink: 0; }
.brand-logo-wrap svg { width: 100%; height: 100%; }
.brand-text { display: flex; flex-direction: column; line-height: 1.05; }
.brand-name { font-family: var(--font-heading); font-weight: 800; font-size: 0.95rem; color: var(--primary); letter-spacing: 0.3px; }
.brand-sub { font-family: var(--font-heading); font-weight: 700; font-size: 0.58rem; letter-spacing: 1px; }
.brand-sub .y { color: var(--yellow); }
.brand-sub .b { color: var(--primary); }
.header-actions { display: flex; align-items: center; gap: 4px; }
.icon-btn { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; transition: background 0.2s; position: relative; }
.icon-btn:active { background: var(--bg); }
.icon-btn svg { width: 22px; height: 22px; stroke: var(--primary); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.user-chip { display: flex; align-items: center; gap: 8px; padding: 4px 10px 4px 4px; background: var(--bg); border-radius: 99px; cursor: pointer; transition: background 0.2s; }
.user-chip:active { background: var(--border); }
.user-avatar-sm { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #2563EB 0%, #1E40AF 100%); display: flex; align-items: center; justify-content: center; color: var(--white); font-family: var(--font-heading); font-weight: 700; font-size: 0.75rem; }
.user-name-sm { font-family: var(--font-heading); font-weight: 600; font-size: 0.82rem; color: var(--primary); }

.app-main { position: fixed; top: var(--header-h); left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; bottom: var(--nav-h); overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; scroll-behavior: smooth; }
@media (min-width: 481px) { .app-main { top: calc(20px + var(--header-h)); bottom: calc(20px + var(--nav-h)); } }
.app-shell.nav-hidden .app-main { bottom: 0; }
@media (min-width: 481px) { .app-shell.nav-hidden .app-main { bottom: 20px; border-radius: 0 0 24px 24px; } }
.app-main::-webkit-scrollbar { width: 0; }

.page-view { display: none; padding: 20px 16px 24px; animation: fadeUp 0.3s ease; }
.page-view.active { display: block; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

.app-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; height: var(--nav-h); background: var(--white); border-top: 1px solid var(--border); display: flex; align-items: stretch; padding: 0 4px; padding-bottom: env(safe-area-inset-bottom, 0); z-index: 100; }
@media (min-width: 481px) { .app-nav { bottom: 20px; border-radius: 0 0 24px 24px; } }
.nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 8px 2px; color: var(--muted-light); transition: color 0.2s; position: relative; min-width: 0; }
.nav-item svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s; }
.nav-item span { font-size: 0.62rem; font-weight: 600; font-family: var(--font-heading); letter-spacing: 0.2px; white-space: nowrap; }
.nav-item.active { color: var(--accent); }
.nav-item.active svg { transform: translateY(-1px); }
.nav-item.active::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 24px; height: 3px; background: var(--accent); border-radius: 0 0 3px 3px; }

.drawer-overlay { position: fixed; inset: 0; background: rgba(10,31,68,0.5); backdrop-filter: blur(4px); z-index: 200; opacity: 0; visibility: hidden; transition: all 0.3s; }
.drawer-overlay.open { opacity: 1; visibility: visible; }
.drawer { position: fixed; top: 0; left: 0; width: 85%; max-width: 340px; height: 100%; background: var(--white); z-index: 201; transform: translateX(-100%); transition: transform 0.35s cubic-bezier(0.25,0.8,0.25,1); display: flex; flex-direction: column; box-shadow: 10px 0 40px rgba(0,0,0,0.1); }
.drawer.open { transform: translateX(0); }
.drawer-head { padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }
.drawer-user { display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-bottom: 1px solid var(--border); background: var(--bg); }
.drawer-user-avatar { width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, #2563EB 0%, #1E40AF 100%); display: flex; align-items: center; justify-content: center; color: var(--white); font-family: var(--font-heading); font-weight: 700; font-size: 1rem; flex-shrink: 0; }
.drawer-user-info { flex: 1; min-width: 0; }
.drawer-user-name { font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; color: var(--primary); }
.drawer-user-email { font-size: 0.75rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.drawer-close { width: 36px; height: 36px; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; transition: background 0.2s; flex-shrink: 0; }
.drawer-close:active { background: var(--border); }
.drawer-close svg { width: 18px; height: 18px; stroke: var(--primary); fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
.drawer-nav { flex: 1; padding: 10px 0; overflow-y: auto; }
.drawer-link { display: block; padding: 16px 24px; font-family: var(--font-heading); font-size: 1rem; font-weight: 600; color: var(--text); border-bottom: 1px solid var(--border); transition: all 0.2s; }
.drawer-link:active { background: var(--bg); }
.drawer-link.active { color: var(--accent); font-weight: 700; }
.drawer-foot { padding: 16px 20px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; }

.page-title { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--text); margin-bottom: 4px; letter-spacing: -0.3px; }
.page-subtitle { color: var(--muted); font-size: 0.9rem; margin-bottom: 20px; }
.section-title { font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: 12px; letter-spacing: -0.2px; }
.card { background: var(--card); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); margin-bottom: 16px; border: 1px solid rgba(226,232,240,0.6); }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 14px 22px; border-radius: var(--radius); font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; transition: all 0.2s; border: none; cursor: pointer; white-space: nowrap; text-decoration: none; }
.btn:active { transform: scale(0.97); }
.btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-primary { background: var(--accent); color: var(--white); box-shadow: 0 4px 14px rgba(37,99,235,0.3); }
.btn-primary:active { background: var(--primary-light); }
.btn-yellow { background: var(--yellow); color: var(--primary); box-shadow: 0 4px 14px rgba(245,185,39,0.3); }
.btn-outline { background: var(--white); color: var(--primary); border: 1.5px solid var(--border); }
.btn-ghost { background: transparent; color: var(--accent); padding: 10px 14px; font-weight: 600; }
.btn-danger { background: var(--danger); color: var(--white); }
.btn-dark { background: var(--primary); color: var(--white); }
.btn-success { background: var(--success); color: var(--white); }
.btn-block { width: 100%; }
.btn-sm { padding: 10px 16px; font-size: 0.85rem; }
.btn-lg { padding: 16px 28px; font-size: 1rem; }

/* LANDING */
.landing-page { background: var(--white); padding: 0 !important; }
.hero { padding: 50px 24px 40px; text-align: center; background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%); }
.hero-motto { display: inline-block; background: rgba(245,185,39,0.15); padding: 10px 20px; border-radius: 50px; color: var(--primary); font-family: var(--font-heading); font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 22px; border: 1px solid rgba(245,185,39,0.4); }
.hero h1 { font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--primary); line-height: 1.15; margin-bottom: 18px; letter-spacing: -0.5px; }
.hero p { font-size: 1rem; color: var(--muted); line-height: 1.6; margin-bottom: 28px; max-width: 400px; margin-left: auto; margin-right: auto; }
.hero-btns { display: flex; flex-direction: column; gap: 12px; max-width: 320px; margin: 0 auto; }
.section { padding: 50px 20px; }
.section-head { text-align: center; margin-bottom: 30px; }
.section-head h2 { font-family: var(--font-heading); font-size: 1.6rem; font-weight: 800; color: var(--primary); margin-bottom: 10px; letter-spacing: -0.3px; }
.section-head p { color: var(--muted); font-size: 0.95rem; max-width: 400px; margin: 0 auto; }
.about-text { max-width: 440px; margin: 0 auto 30px; text-align: center; font-size: 0.95rem; color: var(--muted); line-height: 1.6; }
.about-text strong { color: var(--primary); }
.feature-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
.feature-card { background: var(--white); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow); text-align: center; border: 1px solid rgba(226,232,240,0.6); }
.feature-icon { font-size: 2rem; margin-bottom: 10px; }
.feature-card h3 { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; color: var(--primary); margin-bottom: 6px; }
.feature-card p { font-size: 0.88rem; color: var(--muted); line-height: 1.5; }
.featured-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
.featured-card { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); position: relative; height: 180px; display: flex; align-items: flex-end; cursor: pointer; transition: transform 0.2s; }
.featured-card:active { transform: scale(0.98); }
.featured-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 60%); }
.featured-card-content { position: relative; z-index: 1; padding: 18px; width: 100%; }
.featured-tag { display: inline-block; background: var(--white); color: var(--primary); padding: 5px 12px; border-radius: 20px; font-family: var(--font-heading); font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
.featured-card h3 { color: var(--white); font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; margin-bottom: 3px; }
.featured-card p { color: rgba(255,255,255,0.85); font-size: 0.82rem; }
.stats-wrap { background: linear-gradient(135deg, #0A1F44 0%, #1E3A8A 100%); border-radius: var(--radius); padding: 30px 20px; text-align: center; color: var(--white); position: relative; overflow: hidden; }
.stats-wrap::before { content: ''; position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(circle, rgba(245,185,39,0.15) 0%, transparent 60%); }
.stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; position: relative; z-index: 1; }
.stat-num { font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: var(--yellow); line-height: 1; margin-bottom: 6px; }
.stat-lbl { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; color: rgba(255,255,255,0.85); }
.contact-card { background: var(--white); border-radius: var(--radius); padding: 24px 20px; box-shadow: var(--shadow); border-top: 4px solid var(--yellow); }
.contact-card h3 { font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; color: var(--primary); margin-bottom: 16px; }
.contact-link { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; padding: 12px; border-radius: 12px; transition: all 0.2s; text-decoration: none; color: inherit; }
.contact-link:active { background: var(--bg); transform: scale(0.98); }
.contact-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 1.2rem; flex-shrink: 0; font-weight: 700; }
.contact-link strong { display: block; font-size: 0.82rem; color: var(--primary); font-family: var(--font-heading); font-weight: 600; margin-bottom: 2px; }
.contact-link span { font-size: 0.88rem; color: var(--muted); word-break: break-all; }
.contact-link .arrow { margin-left: auto; color: var(--muted-light); font-size: 1.2rem; }
.social-row { display: flex; gap: 10px; margin-top: 18px; justify-content: center; }
.social-btn { width: 48px; height: 48px; border-radius: 12px; background: var(--primary); color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; transition: all 0.2s; text-decoration: none; }
.social-btn:active { background: var(--yellow); color: var(--primary); transform: translateY(-2px); }
.contact-form { margin-top: 20px; display: flex; flex-direction: column; gap: 10px; }
.contact-form input, .contact-form textarea { width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1.5px solid var(--border); background: var(--bg); font-size: 0.92rem; transition: all 0.2s; }
.contact-form input:focus, .contact-form textarea:focus { outline: none; border-color: var(--accent); background: var(--white); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
.contact-form textarea { min-height: 100px; resize: vertical; }
.footer { background: var(--primary); color: var(--white); padding: 30px 20px 20px; text-align: center; }
.footer p { color: rgba(255,255,255,0.7); font-size: 0.82rem; margin-top: 10px; }
.footer-copy { color: rgba(255,255,255,0.5); font-size: 0.75rem; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1); }

/* DASHBOARD TILES (Figma: Dashboard Home) */
.dash-tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px; }
.dash-tile { background: var(--card); border: 1px solid rgba(226,232,240,0.6); border-radius: var(--radius); padding: 16px; display: flex; align-items: center; gap: 12px; box-shadow: var(--shadow); transition: all 0.2s; text-align: left; }
.dash-tile:active { transform: scale(0.97); border-color: var(--accent); }
.dash-tile-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.dash-tile-label { font-family: var(--font-heading); font-weight: 700; font-size: 0.85rem; color: var(--text); }
.dash-tile-sub { font-size: 0.68rem; color: var(--muted); }

/* OVERVIEW */
.greeting { margin-bottom: 20px; }
.greeting h1 { font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; color: var(--text); margin-bottom: 6px; letter-spacing: -0.3px; }
.greeting p { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
.greeting-avatar { width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #2563EB 0%, #1E40AF 100%); margin-top: 14px; display: flex; align-items: center; justify-content: center; color: var(--white); font-family: var(--font-heading); font-weight: 700; font-size: 1.2rem; box-shadow: 0 6px 16px rgba(37,99,235,0.3); overflow: hidden; }
.greeting-avatar img { width: 100%; height: 100%; object-fit: cover; }
.perf-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
.perf-icon { width: 46px; height: 46px; border-radius: 12px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.perf-icon svg { width: 22px; height: 22px; stroke: var(--accent); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.perf-title { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: 2px; }
.perf-sub { color: var(--muted); font-size: 0.82rem; }
.comp-label { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); }
.comp-value { color: var(--accent); }
.progress-track { width: 100%; height: 8px; background: var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 22px; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #0A1F44 0%, #1E3A8A 100%); border-radius: 8px; transition: width 1s ease; }
.timeline { display: flex; justify-content: space-between; position: relative; padding: 18px 0 4px; }
.timeline::before { content: ''; position: absolute; top: 34px; left: 8%; right: 8%; height: 2px; background: var(--border); }
.tl-item { text-align: center; position: relative; flex: 1; z-index: 1; }
.tl-dot { width: 32px; height: 32px; border-radius: 50%; background: var(--white); border: 2.5px solid var(--border); margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; color: var(--white); font-size: 0.75rem; font-weight: 700; transition: all 0.3s; }
.tl-item.done .tl-dot { background: var(--accent); border-color: var(--accent); box-shadow: 0 3px 10px rgba(37,99,235,0.3); }
.tl-item.now .tl-dot { background: var(--accent); border-color: var(--accent); width: 14px; height: 14px; margin: 9px auto 6px; box-shadow: 0 0 0 4px rgba(37,99,235,0.15); }
.tl-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; color: var(--text); line-height: 1.2; margin-bottom: 2px; }
.tl-date { font-size: 0.62rem; color: var(--muted-light); }
.chart-head { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.chart-head-icon { color: var(--accent); display: flex; }
.chart-head-icon svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.chart-head h3 { font-family: var(--font-heading); font-size: 1rem; font-weight: 700; color: var(--text); }
.chart-wrap { position: relative; width: 100%; height: 240px; }
.stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px; }
.stat-item { background: var(--card); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); display: flex; align-items: center; gap: 12px; border: 1px solid rgba(226,232,240,0.6); }
.stat-icon { width: 38px; height: 38px; border-radius: 10px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.stat-icon svg { width: 18px; height: 18px; stroke: var(--accent); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.stat-lbl { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); margin-bottom: 2px; }
.stat-val { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; color: var(--text); }
.metric-row { background: var(--card); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border: 1px solid rgba(226,232,240,0.6); }
.metric-left { display: flex; align-items: center; gap: 12px; }
.metric-icon { width: 42px; height: 42px; border-radius: 10px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; }
